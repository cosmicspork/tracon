# Everything the whole repository builds with, including the desktop wrapper,
# which needs webkit and gtk headers the node and hub deliberately do not.
# The same package list the justfile's distrobox recipes assume, in an image
# the Dev Container CLI (or VS Code) can stand up on any host with a
# container engine.
FROM registry.fedoraproject.org/fedora@sha256:f315f29f764e4c74fa5b1c60c5be42630fe9276134079fbfb12b44131d08967c

RUN dnf install -y \
        webkit2gtk4.1-devel gtk3-devel libappindicator-gtk3-devel librsvg2-devel \
        rust cargo clippy rustfmt \
        gcc make pkgconf-pkg-config openssl-devel \
        git just nodejs npm unzip fuse \
    && dnf clean all

# Bun's shell installer follows a mutable channel. Fetch the official release
# asset at an exact version and verify the release digest instead.
ARG BUN_VERSION=1.4.2
ARG BUN_LINUX_AARCH64_SHA256=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7
ARG BUN_LINUX_X64_SHA256=36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913
ARG TARGETARCH
RUN set -eu; case "${TARGETARCH}" in \
      amd64) asset=x64; digest="${BUN_LINUX_X64_SHA256}" ;; \
      arm64) asset=aarch64; digest="${BUN_LINUX_AARCH64_SHA256}" ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${asset}.zip"; \
    echo "${digest}  /tmp/bun.zip" | sha256sum -c -; \
    unzip -q /tmp/bun.zip -d /tmp; \
    install -m 0755 "/tmp/bun-linux-${asset}/bun" /usr/local/bin/bun; \
    rm -rf /tmp/bun.zip "/tmp/bun-linux-${asset}"

RUN useradd -m -s /bin/bash dev
USER dev
WORKDIR /workspaces/tracon
