# The node image, for a node that runs as a pod (the Kubernetes runtime). It
# carries the node binary with the SPA embedded, git for worktrees, and the
# consulta sidecar's interpreter (uv, so the Phase 0 "Python 3.9, no uv"
# finding about the work environment no longer applies: the runner topology
# provisions the sidecar's dependencies itself). Laptops do not use this
# image; they fetch the static binary.

FROM docker.io/oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS spa
WORKDIR /build/spa
COPY spa/package.json spa/bun.lock ./
RUN bun install --frozen-lockfile
COPY spa .
RUN bun run build

# OpenCode's native interface, carried in the image. A pod-hosted node has no
# operator to run `tracon setup --ui-bundle`, and its state directory is a
# volume, so the bundle lives on the image's own filesystem and
# TRACON_OPENCODE_UI_DIR points the node at it.
#
# Two ways in, and the same check either way. Drop
# `opencode-ui-v<version>.tar.gz` into `containers/opencode-ui/` for an offline
# build and it is used; otherwise the release asset is fetched. Both are held
# to OPENCODE_UI_TARBALL_SHA256 — the digest of the tarball
# `containers/opencode-ui/build.sh --tar` produces — and then the *tree* digest
# is recomputed here and compared with the checked-in `DIGEST`, which is the
# one the node itself recomputes over the bytes it serves. An image that got
# past both carries the pinned tree.
FROM ghcr.io/astral-sh/uv:0.9.16-python3.13-bookworm-slim@sha256:ceb1b62148bad35cf9cb899a5da44aa15774a5a74860716f0f14d451122e2051 AS opencode-ui
ARG OPENCODE_UI_TARBALL=opencode-ui-v1.18.30.tar.gz
ARG OPENCODE_UI_TARBALL_SHA256=782ca629c49b1e2b620460b90c4d8ec7b1a2ad9bdc9783ba9227ad626cfb6696
ARG TRACON_RELEASE=latest
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY containers/opencode-ui /pin
RUN set -eu; \
    if [ -f "/pin/${OPENCODE_UI_TARBALL}" ]; then \
      echo "using the tarball in the build context"; \
      cp "/pin/${OPENCODE_UI_TARBALL}" /tmp/ui.tar.gz; \
    elif [ "${TRACON_RELEASE}" = "latest" ]; then \
      curl -fsSL -o /tmp/ui.tar.gz "https://github.com/cosmicspork/tracon/releases/latest/download/${OPENCODE_UI_TARBALL}"; \
    else \
      curl -fsSL -o /tmp/ui.tar.gz "https://github.com/cosmicspork/tracon/releases/download/${TRACON_RELEASE}/${OPENCODE_UI_TARBALL}"; \
    fi; \
    echo "${OPENCODE_UI_TARBALL_SHA256}  /tmp/ui.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/tracon/opencode-ui; \
    tar -xzf /tmp/ui.tar.gz -C /opt/tracon/opencode-ui --no-same-owner --no-same-permissions; \
    rm -f /tmp/ui.tar.gz; \
    test -f /opt/tracon/opencode-ui/index.html; \
    # The tree digest, in exactly the form `node/src/http/ui.rs` recomputes
    # over what it is about to serve: path, NUL, bytes, NUL, in path order.
    digest=$(cd /opt/tracon/opencode-ui && find . -type f | sed 's|^\./||' | LC_ALL=C sort \
      | while IFS= read -r p; do printf '%s\0' "$p"; cat "$p"; printf '\0'; done \
      | sha256sum | cut -d' ' -f1); \
    pinned=$(cat /pin/DIGEST); \
    if [ "$digest" != "$pinned" ]; then \
      echo "the unpacked tree is $digest, not the pinned $pinned" >&2; exit 1; \
    fi; \
    echo "opencode-ui tree digest $digest"; \
    chmod -R a+rX /opt/tracon/opencode-ui

FROM docker.io/library/rust@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS builder
WORKDIR /build
COPY . .
COPY --from=spa /build/spa/dist spa/dist
RUN cargo build -p tracon --release --bin tracon

# consulta, at a pinned commit, with its environment resolved at build time so
# the first query does not wait on a download inside the boundary.
FROM ghcr.io/astral-sh/uv:0.9.16-python3.13-bookworm-slim@sha256:ceb1b62148bad35cf9cb899a5da44aa15774a5a74860716f0f14d451122e2051 AS consulta
ARG CONSULTA_REV=5932f23a7bc33462bae3f1911bd807d0ac1ba28c
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git init /opt/consulta \
    && git -C /opt/consulta remote add origin https://github.com/cosmicspork/consulta.git \
    && git -C /opt/consulta fetch --depth 1 origin "$CONSULTA_REV" \
    && git -C /opt/consulta checkout --detach FETCH_HEAD
WORKDIR /opt/consulta
ENV UV_LINK_MODE=copy
RUN uv sync --frozen --no-dev

# The runtime is the same image consulta's environment was resolved on, so
# its venv's interpreter link holds; uv runs it offline from here.
FROM ghcr.io/astral-sh/uv:0.9.16-python3.13-bookworm-slim@sha256:ceb1b62148bad35cf9cb899a5da44aa15774a5a74860716f0f14d451122e2051
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates git curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/tracon /usr/local/bin/tracon
COPY --from=consulta /opt/consulta /opt/consulta
COPY --from=opencode-ui /opt/tracon/opencode-ui /opt/tracon/opencode-ui
ENV UV_NO_SYNC=1 UV_OFFLINE=1 UV_CACHE_DIR=/tmp/uv-cache
# The bundle is on the image's filesystem rather than in the state volume,
# which is a mount and would shadow it. The node verifies the tree digest at
# startup either way and serves nothing if it does not match.
ENV TRACON_OPENCODE_UI_DIR=/opt/tracon/opencode-ui
# State and config are volumes; the deployment sets XDG_STATE_HOME=/state and
# XDG_CONFIG_HOME=/config. Runs as uid 65532, the same uid the harness pods
# use, so what each writes on the shared claim the other can read.
RUN mkdir -p /state /config \
    && chown -R 65532:65532 /state /config /opt/consulta
USER 65532:65532
ENTRYPOINT ["tracon"]
CMD ["serve"]
