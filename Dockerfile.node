# The node image, for a node that runs as a pod (the Kubernetes runtime). It
# carries the node binary with the SPA embedded and git for worktrees. SQL is
# the sql-review plugin's, installed with `tracon plugin add`, not part of
# this image. Laptops do not use this image; they fetch the static binary.

FROM docker.io/oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS spa
WORKDIR /build/spa
COPY spa/package.json spa/bun.lock ./
RUN bun install --frozen-lockfile
COPY spa .
COPY Cargo.toml /build/Cargo.toml
# The generated-name word lists, which the SPA embeds from the node's copy.
COPY proto/src/names-v1.json /build/proto/src/names-v1.json
RUN bun run build

# Third-party crates are built in their own layer, keyed on a recipe that
# cargo-chef derives from the manifests alone. The source differs on every
# release, so without this every release recompiled every dependency. The
# recipe masks the workspace's own version, so a release-please bump keeps it.
FROM docker.io/library/rust@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS chef
# webauthn-rs links a vendored OpenSSL, whose Configure needs the full perl
# (the image has only perl-base) and make. Debian's live suite is mutable; this
# official snapshot fixes every apt dependency selected below.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends perl make \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /build

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release -p tracon --bin tracon --recipe-path recipe.json
COPY . .
COPY --from=spa /build/spa/dist spa/dist
RUN cargo build -p tracon --release --bin tracon

# buildctl, the client a pod-hosted node builds repository images with
# (`[runtime.kubernetes.builder]`): it talks to a BuildKit daemon over mutual
# TLS and answers that daemon's registry token requests from the node's own
# DOCKER_CONFIG. The client only; the daemon is the deployment's. The release
# tarball is held to its published sha256 before anything is unpacked. The node
# image is built for linux/amd64 alone, so the tarball is that platform's.
FROM ghcr.io/astral-sh/uv:0.9.16-python3.13-bookworm-slim@sha256:ceb1b62148bad35cf9cb899a5da44aa15774a5a74860716f0f14d451122e2051 AS buildctl
ARG BUILDKIT_VERSION=v0.34.0
ARG BUILDKIT_SHA256=14813b1fb2a40082114e6d386c6fc5e7dd5298176ce7ee1a18bc33e73e109ac3
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    curl -fsSL -o /tmp/buildkit.tar.gz \
      "https://github.com/moby/buildkit/releases/download/${BUILDKIT_VERSION}/buildkit-${BUILDKIT_VERSION}.linux-amd64.tar.gz"; \
    echo "${BUILDKIT_SHA256}  /tmp/buildkit.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/buildkit.tar.gz -C /tmp bin/buildctl; \
    install -m 0755 /tmp/bin/buildctl /usr/local/bin/buildctl; \
    /usr/local/bin/buildctl --version

# The runtime is a pinned Debian bookworm: the uv image consulta's sidecar
# needed, kept as it was when SQL moved to the sql-review plugin, though
# nothing here runs uv any more. gh is what an approved GitHub review opens
# its pull request with (`publish.gh`); without it the branch is pushed and
# the request never opened. It comes from the same
# pinned snapshot as everything else here. Bookworm has no glab, so a GitLab
# publication still needs `publish.glab` pointed at one the deployment mounts.
FROM ghcr.io/astral-sh/uv:0.9.16-python3.13-bookworm-slim@sha256:ceb1b62148bad35cf9cb899a5da44aa15774a5a74860716f0f14d451122e2051
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates git curl gh \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/tracon /usr/local/bin/tracon
COPY --from=buildctl /usr/local/bin/buildctl /usr/local/bin/buildctl
# State and config are volumes; the deployment sets XDG_STATE_HOME=/state and
# XDG_CONFIG_HOME=/config. Runs as uid 65532, the same uid the harness pods
# use, so what each writes on the shared claim the other can read.
RUN mkdir -p /state /config \
    && chown -R 65532:65532 /state /config
USER 65532:65532
ENTRYPOINT ["tracon"]
CMD ["serve"]
