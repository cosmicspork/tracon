# The headless-shell the `browser` service bundle is assembled from. Nothing
# builds or publishes this as an image any more: a session's sandbox runs the
# bundle under its supervisor. The FROM line is the pin, read by
# scripts/browser-bundle.sh (what goes in the bundle) and node/build.rs (which
# Chrome a release's bundle is named for), and moved by Dependabot.
#
# Upstream's entrypoint (`/headless-shell/run.sh`) runs socat on 0.0.0.0:9222
# in front of Chrome, so the bundle's `run` starts Chrome itself, bound to
# loopback; `browser.yml` smoke-tests that it listens nowhere else.
FROM docker.io/chromedp/headless-shell:158.0.8127.2@sha256:84fc19d85ada48c6bfa850cb648f01a9f93153872a9a405ea322d79fcc98ef3a
