# The Postgres the `postgres` service bundle is assembled from. Nothing builds
# or publishes this as an image: a session's sandbox runs the bundle under
# its supervisor. The FROM line is the pin, read by scripts/database-bundle.sh
# (what goes in the bundle, and the version it is named for), and moved by
# Dependabot. A Debian image, so its libraries are held to the stock base's
# glibc by the script.
FROM docker.io/library/postgres:17.12-bookworm@sha256:837bed18782820fe967067cb5328b02b0d9992c1be9a37ee0c9c492cfc03af3b
