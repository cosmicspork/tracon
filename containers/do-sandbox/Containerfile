# The source image of a node's DigitalOcean Harness Runtime template: one of
# the node's sandbox images (the stock base, a prepared snapshot) with the
# harness bundle at /opt/tracon and the `tracon-sandbox` s6 service, which
# waits for the bootstrap the node delivers by exec after each create and
# then runs the supervisor as its child under the runtime's own init. With
# `[digitalocean] registry` the node builds and pushes these itself, from
# this file; by hand, for `[digitalocean] image`:
#
#   cp -a <bundle>/<version>/amd64 containers/do-sandbox/bundle
#   podman build --build-arg BASE=<sandbox image> \
#     -t <registry>/tracon-do-sandbox containers/do-sandbox
#   podman push <registry>/tracon-do-sandbox   # then name it by digest
#
# The runtime rebases it onto its base template, so the image that runs is
# the runtime's own build of this one.
ARG BASE
FROM ${BASE}
# Root to install; the runtime's init starts the service as root either way.
USER root
COPY bundle/ /opt/tracon/
RUN test -x /opt/tracon/bin/tracon-sandbox
COPY run /etc/services.d/tracon-sandbox/run
RUN chmod 0755 /etc/services.d/tracon-sandbox/run
