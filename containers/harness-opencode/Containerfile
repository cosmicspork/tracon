# Harness runner: OpenCode at a pinned version, git, CA certificates, and
# ripgrep. No network at run time; everything the harness reaches goes through
# the tracon gateway, and the provider base URLs are in the config file the
# node writes rather than in the environment — OpenCode reads no base-URL
# environment variable (docs/reference/opencode-v1.18.30/providers.md §2.5).
#
# A third image rather than one image with every harness: a node runs one
# harness, the version is pinned per node, and putting them all in a layer
# means every node carries the ones it does not use.
FROM docker.io/library/debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
ARG OPENCODE_VERSION=1.18.30
ARG OPENCODE_LINUX_ARM64_SHA256=4111a55c2a02c0fac314bd51e9a2330280e6d29d2b85b9554fff6d62612566ed
ARG OPENCODE_LINUX_X64_SHA256=55007246858165496ff85ba1c2b648f7421e8e2013bf4189a680c9ff8e699d17
ARG TARGETARCH
# CA certificates are needed before apt can reach the HTTPS snapshot below.
# The base image's default sources are plain HTTP with Release signatures
# verified against the pre-installed debian-archive-keyring, so bootstrapping
# them needs no unverified transport.
#
# ripgrep is installed rather than left to the harness: OpenCode downloads `rg`
# at first use with no flag to stop it (finding 8b of the manifest), and an
# image that ships it is the only thing that prevents that call.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends git curl ripgrep \
    && rm -rf /var/lib/apt/lists/*
# The official release archive is checked before its binary is extracted; the
# mutable convenience installer is never part of this image build.
RUN set -eu; case "${TARGETARCH}" in \
      amd64) asset=x64; digest="${OPENCODE_LINUX_X64_SHA256}" ;; \
      arm64) asset=arm64; digest="${OPENCODE_LINUX_ARM64_SHA256}" ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/opencode.tar.gz "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-${asset}.tar.gz"; \
    echo "${digest}  /tmp/opencode.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/opencode.tar.gz -C /tmp; \
    install -m 0755 /tmp/opencode /usr/local/bin/opencode; \
    rm -f /tmp/opencode.tar.gz /tmp/opencode; \
    /usr/local/bin/opencode --version
# `/etc/opencode` is the one configuration source with no environment control
# (manifest finding 12), so the claim "no ambient discovery" holds only for an
# image that does not contain it. This asserts that, rather than assuming it.
RUN test ! -e /etc/opencode
# No `OPENCODE_*` variable is set here. Where this harness keeps its state is
# decided per session by the HOME and XDG values in the node's launch
# environment, and a value baked in the image could only disagree with them.
# Under Podman the harness is root and its home is /root; as a pod it runs as
# uid 65532 with HOME=/home/harness. No USER directive: the runtime chooses,
# and verifies what it chose.
RUN mkdir -p /home/harness /work && chown 65532:65532 /home/harness /work
WORKDIR /work
