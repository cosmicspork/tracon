{
  "name": "@tracon/ui",
  "version": "0.60.0",
  "description": "Tracon's design tokens, base styles, theme bridge and Svelte components, for the interface and plugin pages.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./index.css": "./index.css",
    "./svelte": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./word-diff": {
      "types": "./dist/word-diff.d.ts",
      "default": "./dist/word-diff.js"
    }
  },
  "files": [
    "dist",
    "svelte",
    "tokens.css",
    "base.css",
    "index.css",
    "load.ts",
    "segmented.ts",
    "word-diff.ts",
    "!svelte/*.test.ts",
    "!svelte/test-plugin.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -p tsconfig.build.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.4.0",
    "playwright-core": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
