# The node runs as a user service, not a system one: its state, config, and
# harness socket all live under the operator's XDG directories, and rootless
# podman needs the user session. `tracon service install` writes this file,
# naming the binary it was run from.
[Unit]
Description=tracon node
Documentation=https://github.com/cosmicspork/tracon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart="__BIN__" serve
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=tracon=info
Environment="PATH=__PATH__"
# The node ends its sessions on SIGTERM and tears down their harness
# containers, except a sandbox over the sandbox protocol that can resume,
# which it leaves for the next start to carry its session on in ([sandbox]
# resume_within_secs). Killing it sooner orphans the containers.
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=default.target
