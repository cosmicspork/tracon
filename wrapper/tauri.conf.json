{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracon",
  "version": "0.9.1",
  "identifier": "com.cosmicspork.tracon",
  "build": {
    "frontendDist": "../spa/dist"
  },
  "app": {
    "windows": [
      {
        "title": "tracon",
        "width": 1100,
        "height": 840,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#141517"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tray client and supervisor for a tracon node",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
