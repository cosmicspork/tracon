{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "node-interface",
  "description": "Allows the loopback node interface to install desktop updates and manage the node's CLI and service.",
  "windows": ["main"],
  "platforms": ["linux", "macOS"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "allow-desktop-managed-local",
    "allow-desktop-update-status",
    "allow-desktop-check-for-update",
    "allow-desktop-install-update",
    "allow-desktop-setup-status",
    "allow-desktop-install-cli",
    "allow-desktop-restart-node",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
